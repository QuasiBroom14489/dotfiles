// Zellij — Tokyo Night, mouse enabled, discoverable keybinds
// Docs: https://zellij.dev/documentation/

theme "tokyo-night"
default_layout "compact"
default_shell "zsh"
mouse_mode true
copy_on_select true
scrollback_editor "/opt/homebrew/bin/nvim"
show_startup_tips false
show_release_notes false
pane_frames false
simplified_ui true

themes {
    tokyo-night {
        fg  "#c0caf5"
        bg  "#1a1b26"
        black   "#15161e"
        red     "#f7768e"
        green   "#9ece6a"
        yellow  "#e0af68"
        blue    "#7aa2f7"
        magenta "#bb9af7"
        cyan    "#7dcfff"
        white   "#a9b1d6"
        orange  "#ff9e64"
    }
}
